# Bill.com AP/AR API Configuration
# See plugin README for credential mapping from the Bill.com portal.

# Required: Developer Key (Settings → Sync & Integrations → Manage Developer Keys)
BILL_DEV_KEY=your_developer_key_here

# Required for sync_token / full_access: Sync Token Name (or user email for full_access)
BILL_USERNAME=your_sync_token_name

# Required for sync_token / full_access: Sync Token Value (or user password for full_access)
BILL_PASSWORD=your_sync_token_value

# Required for sync_token / full_access: Organization ID (starts with 008)
BILL_ORGANIZATION_ID=008xxxxxxxxxxxxx

# Optional: production | sandbox (default: production)
BILL_ENVIRONMENT=production

# Optional: sync_token | full_access | session_token (default: sync_token)
BILL_AUTH_TYPE=sync_token

# Only for session_token auth:
# BILL_SESSION_TOKEN=your_pre_authenticated_session_token
